# Copiar este archivo como .env y completar los valores

# Servidor
PORT=3000
NODE_ENV=development
# Origen permitido para el frontend (en desarrollo, Vite usa el 5173)
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adopcion_animales
# En la nube (Railway) basta con esta variable y se ignoran las DB_* de arriba
# DATABASE_URL=mysql://usuario:clave@host:3306/adopcion_animales

# Sesiones (JWT): usar un texto largo y aleatorio
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
JWT_EXPIRA=8h

# Administrador inicial (lo crea: npm run crear-admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@adopta.cl
ADMIN_PASSWORD=
